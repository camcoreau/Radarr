FROM lscr.io/linuxserver/radarr:latest

LABEL org.opencontainers.image.title="CamCore Radarr"
LABEL org.opencontainers.image.description="Radarr with CamCore branding"

COPY frontend/src/Content/Images/logo-full.png /app/radarr/bin/UI/Content/Images/logo-full.png
COPY frontend/src/Content/Images/camcore-logo.svg /app/radarr/bin/UI/Content/Images/logo.svg
COPY frontend/src/login.html /app/radarr/bin/UI/login.html
COPY frontend/src/Content/Images/Icons/camcore-icon.svg /app/radarr/bin/UI/Content/Images/Icons/camcore-icon.svg
COPY frontend/src/Content/Images/Icons/camcore-icon.svg /app/radarr/bin/UI/Content/Images/Icons/safari-pinned-tab.svg
COPY frontend/src/Content/Images/Icons/camcore-apple-touch-icon.png /app/radarr/bin/UI/Content/Images/Icons/camcore-apple-touch-icon.png
COPY frontend/src/Content/Images/Icons/camcore-apple-touch-icon.png /app/radarr/bin/UI/Content/Images/Icons/apple-touch-icon.png
COPY frontend/src/Content/Images/Icons/camcore-apple-touch-icon.png /app/radarr/bin/UI/Content/Images/Icons/favicon-32x32.png
COPY frontend/src/Content/Images/Icons/camcore-apple-touch-icon.png /app/radarr/bin/UI/Content/Images/Icons/favicon-16x16.png
COPY frontend/src/Content/camcore-manifest.json /app/radarr/bin/UI/Content/manifest.json
COPY frontend/src/Content/camcore-header.css /app/radarr/bin/UI/Content/camcore-header.css

RUN sed -i 's#</head>#<link rel="stylesheet" href="/Content/camcore-header.css" /></head>#' /app/radarr/bin/UI/index.html \
 && grep -q 'camcore-header.css' /app/radarr/bin/UI/index.html
