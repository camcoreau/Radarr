FROM lscr.io/linuxserver/radarr:latest

LABEL org.opencontainers.image.title="CamCore Radarr"
LABEL org.opencontainers.image.description="Radarr with CamCore branding"

COPY frontend/src/Content/Images/logo-full.png /app/radarr/bin/UI/Content/Images/logo-full.png
COPY frontend/src/login.html /app/radarr/bin/UI/login.html
COPY frontend/src/Content/Images/Icons/camcore-icon.svg /app/radarr/bin/UI/Content/Images/Icons/camcore-icon.svg
COPY frontend/src/Content/Images/Icons/camcore-apple-touch-icon.png /app/radarr/bin/UI/Content/Images/Icons/camcore-apple-touch-icon.png
COPY frontend/src/Content/camcore-manifest.json /app/radarr/bin/UI/Content/manifest.json

RUN sed -i \
      -e 's#/Content/Images/Icons/apple-touch-icon\\.png#/Content/Images/Icons/camcore-apple-touch-icon.png#g' \
      -e 's#/Content/Images/Icons/favicon-32x32\\.png#/Content/Images/Icons/camcore-icon.svg#g' \
      -e 's#/Content/Images/Icons/favicon-16x16\\.png#/Content/Images/Icons/camcore-icon.svg#g' \
      -e 's#/Content/Images/Icons/safari-pinned-tab\\.svg#/Content/Images/Icons/camcore-icon.svg#g' \
      -e 's#href="/favicon\\.ico"#href="/Content/Images/Icons/camcore-icon.svg"#g' \
      -e 's#type="image/ico"#type="image/svg+xml"#g' \
      -e 's#content="/Content/browserconfig\\.xml"#content="none"#g' \
      /app/radarr/bin/UI/index.html \
      /app/radarr/bin/UI/login.html \
 && grep -q 'camcore-icon.svg' /app/radarr/bin/UI/index.html \
 && grep -q 'camcore-icon.svg' /app/radarr/bin/UI/login.html \
 && grep -q 'camcore-icon.svg' /app/radarr/bin/UI/Content/manifest.json \
 && ! grep -qsE '/Content/Images/Icons/(apple-touch-icon\\.png|favicon-(16x16|32x32)\\.png|safari-pinned-tab\\.svg)|href="/favicon\\.ico"|content="/Content/browserconfig\\.xml"' \
      /app/radarr/bin/UI/index.html \
      /app/radarr/bin/UI/login.html
